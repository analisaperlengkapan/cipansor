// =====================================
// TATA NASKAH DINAS (E-OFFICE)
// =====================================

enum LetterDirection {
  INCOMING // Surat Masuk
  OUTGOING // Surat Keluar
}

enum LetterUrgency {
  NORMAL // Biasa
  IMMEDIATE // Segera
  URGENT // Amat Segera
}

enum LetterNature {
  PUBLIC // Biasa
  CONFIDENTIAL // Rahasia
  STRICTLY_CONFIDENTIAL // Sangat Rahasia
}

enum LetterStatus {
  DRAFT // Konsep
  PENDING_REVIEW // Menunggu Paraf/Review
  REVISION_NEEDED // Perlu Revisi
  READY_TO_SIGN // Siap Tanda Tangan
  SIGNED // Sudah Ditandatangani
  SENT // Sudah Dikirim (untuk Surat Keluar)
  ARCHIVED // Diarsipkan
  DISPOSED // Sudah Didisposisikan (untuk Surat Masuk)
}

/// FilingClassification - Kode Klasifikasi Arsip (Pola Klasifikasi)
model FilingClassification {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "000", "421"
  name        String // e.g. "Umum", "Pendidikan"
  description String?  @db.Text
  retention   Int?     @map("retention_years") // Masa retensi dalam tahun
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  letters Letter[]

  @@index([code])
  @@map("filing_classifications")
}

/// AgendaNumber - Penomoran Surat Otomatis
model AgendaNumber {
  id             String @id @default(uuid())
  unitId         String @map("unit_id")
  academicYearId String @map("academic_year_id")
  type           String // INCOMING, OUTGOING, SK, SURAT_TUGAS, etc.
  lastNumber     Int    @default(0) @map("last_number")
  format         String // e.g. "[NO]/SMA-Q/[ROMA]/[YEAR]"
  resetPeriod    String @default("YEARLY") // YEARLY, MONTHLY

  // Relations
  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([unitId, academicYearId, type])
  @@map("agenda_numbers")
}

/// Letter - Naskah Dinas (Surat Masuk/Keluar)
model Letter {
  id               String          @id @default(uuid())
  unitId           String          @map("unit_id")
  direction        LetterDirection
  classificationId String?         @map("classification_id")
  // Metadata
  agendaNumber     String?         @map("agenda_number") // Nomor Urut Agenda (Surat Masuk)
  letterNumber     String?         @map("letter_number") // Nomor Surat (Surat Keluar)
  date             DateTime        @db.Date // Tanggal Surat
  receivedAt       DateTime?       @map("received_at") // Tanggal Diterima (Surat Masuk)
  // Content
  subject          String // Perihal
  content          String?         @db.Text // Ringkasan atau Isi Surat
  fileUrl          String?         @map("file_url") // File Naskah Asli (Scan/PDF)
  // Attributes
  urgency          LetterUrgency   @default(NORMAL)
  nature           LetterNature    @default(PUBLIC)
  status           LetterStatus    @default(DRAFT)
  // External Parties (if not linked to User/Unit)
  senderName       String?         @map("sender_name") // Pengirim (External)
  senderTitle      String?         @map("sender_title")
  senderInstance   String?         @map("sender_instance") // Instansi Pengirim
  recipientName    String?         @map("recipient_name") // Penerima (External)
  recipientInstance String?        @map("recipient_instance")

  // Relations
  unit           Unit                  @relation(fields: [unitId], references: [id])
  classification FilingClassification? @relation(fields: [classificationId], references: [id])
  createdById    String                @map("created_by_id")
  createdBy      User                  @relation("LetterCreator", fields: [createdById], references: [id])
  reviewers      LetterReviewer[]
  recipients     LetterRecipient[]
  dispositions   Disposition[]         @relation("LetterDispositions")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([unitId])
  @@index([direction])
  @@index([status])
  @@index([date])
  @@map("letters")
}

/// LetterReviewer - Workflow Persetujuan (Paraf/Tanda Tangan)
model LetterReviewer {
  id         String    @id @default(uuid())
  letterId   String    @map("letter_id")
  reviewerId String    @map("reviewer_id")
  order      Int       @default(1) // Urutan review (1, 2, 3...)
  status     String    @default("PENDING") // PENDING, APPROVED, REJECTED, REVISION
  isSigner   Boolean   @default(false) @map("is_signer") // True = Penandatangan akhir
  notes      String?   @db.Text
  reviewedAt DateTime? @map("reviewed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  letter   Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  reviewer User   @relation(fields: [reviewerId], references: [id])

  @@unique([letterId, reviewerId])
  @@index([letterId])
  @@index([reviewerId])
  @@map("letter_reviewers")
}

/// LetterRecipient - Penerima Surat (Internal)
model LetterRecipient {
  id         String    @id @default(uuid())
  letterId   String    @map("letter_id")
  userId     String?   @map("user_id") // Penerima Internal User
  unitId     String?   @map("unit_id") // Penerima Unit
  isCC       Boolean   @default(false) @map("is_cc") // Tembusan
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  // Relations
  letter Letter @relation(fields: [letterId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])
  unit   Unit?  @relation(fields: [unitId], references: [id])

  @@index([letterId])
  @@index([userId])
  @@map("letter_recipients")
}

/// Disposition - Disposisi Surat
model Disposition {
  id             String    @id @default(uuid())
  letterId       String    @map("letter_id")
  senderId       String    @map("sender_id") // Pemberi Disposisi
  recipientId    String    @map("recipient_id") // Penerima Disposisi
  instruction    String    @db.Text // Isi Instruksi (e.g., "Tindak Lanjuti", "Arsipkan")
  deadline       DateTime?
  status         String    @default("PENDING") // PENDING, COMPLETED, IN_PROGRESS
  notes          String?   @db.Text // Catatan tambahan / Laporan hasil
  completedAt    DateTime? @map("completed_at")
  parentDispositionId String? @map("parent_disposition_id") // Untuk disposisi berjenjang

  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  letter            Letter       @relation("LetterDispositions", fields: [letterId], references: [id], onDelete: Cascade)
  sender            User         @relation("DispositionSender", fields: [senderId], references: [id])
  recipient         User         @relation("DispositionRecipient", fields: [recipientId], references: [id])
  parentDisposition Disposition? @relation("DispositionHierarchy", fields: [parentDispositionId], references: [id])
  childDispositions Disposition[] @relation("DispositionHierarchy")

  @@index([letterId])
  @@index([senderId])
  @@index([recipientId])
  @@map("dispositions")
}

// =====================================
// PHASE 13: QUALITY ASSURANCE (SPMI)
// =====================================

enum QualityStandardType {
  STANDAR_ISI
  STANDAR_PROSES
  STANDAR_KOMPETENSI_LULUSAN
  STANDAR_PENDIDIK_DAN_TENAGA_KEPENDIDIKAN
  STANDAR_SARANA_DAN_PRASARANA
  STANDAR_PENGELOLAAN
  STANDAR_PEMBIAYAAN
  STANDAR_PENILAIAN_PENDIDIKAN
}

enum AuditStatus {
  PLANNED
  ONGOING
  COMPLETED
  CLOSED
}

/// QualityStandard - 8 Standar Nasional Pendidikan
model QualityStandard {
  id          String              @id @default(uuid())
  type        QualityStandardType @unique // One record per standard type
  name        String              // "Standar Isi", "Standar Proses"
  description String?             @db.Text
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  // Relations
  indicators  QualityIndicator[]

  @@map("quality_standards")
}

/// QualityIndicator - Indikator per Standar
model QualityIndicator {
  id          String          @id @default(uuid())
  standardId  String          @map("standard_id")
  code        String          // "1.1", "1.2"
  name        String
  description String?         @db.Text
  targetScore Float           @default(100) @map("target_score")
  isActive    Boolean         @default(true) @map("is_active")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  // Relations
  standard    QualityStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)
  evidences   QualityEvidence[]
  auditItems  QualityAuditItem[]

  @@index([standardId])
  @@map("quality_indicators")
}

/// QualityEvidence - Bukti Fisik Akreditasi
model QualityEvidence {
  id          String   @id @default(uuid())
  unitId      String   @map("unit_id")
  indicatorId String   @map("indicator_id")
  academicYearId String @map("academic_year_id")
  name        String   // "RPP Matematika Kelas 7"
  fileUrl     String   @map("file_url")
  description String?  @db.Text
  uploadedById String  @map("uploaded_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  unit        Unit             @relation(fields: [unitId], references: [id])
  indicator   QualityIndicator @relation(fields: [indicatorId], references: [id])
  academicYear AcademicYear    @relation(fields: [academicYearId], references: [id])
  uploadedBy  User             @relation("EvidenceUploader", fields: [uploadedById], references: [id])

  @@index([unitId])
  @@index([indicatorId])
  @@index([academicYearId])
  @@map("quality_evidences")
}

/// QualityAudit - Audit Mutu Internal (AMI)
model QualityAudit {
  id             String      @id @default(uuid())
  unitId         String      @map("unit_id")
  academicYearId String      @map("academic_year_id")
  code           String      // "AMI-2024-01"
  name           String      // "Audit Mutu Semester Ganjil"
  startDate      DateTime    @map("start_date")
  endDate        DateTime    @map("end_date")
  status         AuditStatus @default(PLANNED)
  leadAuditorId  String?     @map("lead_auditor_id")
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  // Relations
  unit         Unit             @relation(fields: [unitId], references: [id])
  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id])
  leadAuditor  User?            @relation("AuditLeader", fields: [leadAuditorId], references: [id])
  items        QualityAuditItem[]

  @@index([unitId])
  @@index([academicYearId])
  @@index([status])
  @@map("quality_audits")
}

/// QualityAuditItem - Detail Audit per Indikator
model QualityAuditItem {
  id          String   @id @default(uuid())
  auditId     String   @map("audit_id")
  indicatorId String   @map("indicator_id")
  score       Float?   // Skor hasil audit
  notes       String?  @db.Text // Temuan audit
  auditorId   String?  @map("auditor_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  audit       QualityAudit     @relation(fields: [auditId], references: [id], onDelete: Cascade)
  indicator   QualityIndicator @relation(fields: [indicatorId], references: [id])
  auditor     User?            @relation("Auditor", fields: [auditorId], references: [id])

  @@unique([auditId, indicatorId])
  @@index([auditId])
  @@index([indicatorId])
  @@map("quality_audit_items")
}

// =====================================
// CBT (COMPUTER BASED TEST) MODELS
// =====================================

enum QuestionType {
  MULTIPLE_CHOICE
  ESSAY
  TRUE_FALSE
}

enum ExamAttemptStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

/// QuestionBank - Bank Soal
model QuestionBank {
  id          String   @id @default(uuid())
  unitId      String   @map("unit_id")
  teacherId   String   @map("teacher_id")
  subjectId   String?  @map("subject_id")
  title       String
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  unit      Unit      @relation(fields: [unitId], references: [id])
  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  subject   Subject?  @relation(fields: [subjectId], references: [id])
  questions Question[]
  exams     Exam[]

  @@index([unitId])
  @@index([teacherId])
  @@map("question_banks")
}

/// Question - Butir Soal
model Question {
  id          String       @id @default(uuid())
  bankId      String       @map("bank_id")
  type        QuestionType
  content     String       @db.Text
  options     Json?        // Array of options for MC
  answerKey   Json?        @map("answer_key") // Correct answer
  explanation String?      @db.Text
  points      Int          @default(1)
  order       Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  bank        QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  examAnswers ExamAnswer[]

  @@index([bankId])
  @@map("questions")
}

/// ExamAttempt - Sesi Ujian Siswa
model ExamAttempt {
  id         String            @id @default(uuid())
  examId     String            @map("exam_id")
  studentId  String            @map("student_id")
  startedAt  DateTime          @default(now()) @map("started_at")
  finishedAt DateTime?         @map("finished_at")
  score      Decimal?          @db.Decimal(5, 2)
  status     ExamAttemptStatus @default(IN_PROGRESS)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  // Relations
  exam    Exam         @relation(fields: [examId], references: [id])
  student Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@map("exam_attempts")
}

/// ExamAnswer - Jawaban Siswa
model ExamAnswer {
  id         String   @id @default(uuid())
  attemptId  String   @map("attempt_id")
  questionId String   @map("question_id")
  answer     Json?    // Student's answer
  isCorrect  Boolean? @map("is_correct")
  score      Decimal? @db.Decimal(5, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  attempt  ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("exam_answers")
}

// =====================================
// ASSIGNMENT MODULE (TUGAS/PR)
// =====================================

enum AssignmentType {
  INDIVIDUAL
  GROUP
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  GRADED
  RETURNED
}

/// Assignment - Tugas/Pekerjaan Rumah
model Assignment {
  id             String         @id @default(uuid())
  unitId         String         @map("unit_id")
  academicYearId String         @map("academic_year_id")
  teacherId      String         @map("teacher_id")
  subjectId      String         @map("subject_id")
  classId        String?        @map("class_id")

  title          String
  description    String?        @db.Text
  type           AssignmentType @default(INDIVIDUAL)
  dueDate        DateTime       @map("due_date")
  attachments    Json?          // Array of file URLs

  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Relations
  unit         Unit                   @relation(fields: [unitId], references: [id])
  academicYear AcademicYear           @relation(fields: [academicYearId], references: [id])
  teacher      Teacher                @relation(fields: [teacherId], references: [id])
  subject      Subject                @relation(fields: [subjectId], references: [id])
  class        Class?                 @relation(fields: [classId], references: [id])
  submissions  AssignmentSubmission[]

  @@index([unitId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
  @@map("assignments")
}

/// AssignmentSubmission - Pengumpulan Tugas
model AssignmentSubmission {
  id           String           @id @default(uuid())
  assignmentId String           @map("assignment_id")
  studentId    String           @map("student_id")

  content      String?          @db.Text
  attachments  Json?            // Array of file URLs

  submittedAt  DateTime         @default(now()) @map("submitted_at")
  status       SubmissionStatus @default(SUBMITTED)

  grade        Decimal?         @db.Decimal(5, 2)
  feedback     String?          @db.Text

  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
  @@map("assignment_submissions")
}

// =====================================
// RISK MANAGEMENT (MANAJEMEN RISIKO)
// =====================================

enum RiskCategory {
  STRATEGIC
  FINANCIAL
  OPERATIONAL
  COMPLIANCE
  REPUTATIONAL
  SAFETY
  OTHER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  EXTREME
}

enum RiskLikelihood {
  RARE // 1
  UNLIKELY // 2
  POSSIBLE // 3
  LIKELY // 4
  ALMOST_CERTAIN // 5
}

enum RiskImpact {
  INSIGNIFICANT // 1
  MINOR // 2
  MODERATE // 3
  MAJOR // 4
  CATASTROPHIC // 5
}

enum MitigationStrategy {
  AVOID
  REDUCE
  SHARE
  ACCEPT
}

/// Risk - Identifikasi dan Analisis Risiko
model Risk {
  id              String         @id @default(uuid())
  unitId          String         @map("unit_id")
  academicYearId  String?        @map("academic_year_id")
  code            String         // RSK-001 (Generated or Manual)
  description     String         @db.Text
  category        RiskCategory
  cause           String?        @db.Text
  consequence     String?        @db.Text

  // Assessment (Inherent Risk - Before Mitigation)
  likelihood      RiskLikelihood
  impact          RiskImpact
  riskScore       Int            // Calculated (Likelihood * Impact)
  riskLevel       RiskLevel      // Calculated

  // Owner
  ownerId         String?        @map("owner_id") // User or Department

  // Status
  status          String         @default("OPEN") // OPEN, CLOSED, MONITORING

  createdById     String         @map("created_by_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  unit            Unit           @relation(fields: [unitId], references: [id])
  academicYear    AcademicYear?  @relation(fields: [academicYearId], references: [id])
  createdBy       User           @relation("RiskCreator", fields: [createdById], references: [id])
  mitigations     RiskMitigation[]

  @@index([unitId])
  @@index([category])
  @@index([riskLevel])
  @@map("risks")
}

/// RiskMitigation - Rencana Penanganan Risiko
model RiskMitigation {
  id              String             @id @default(uuid())
  riskId          String             @map("risk_id")
  strategy        MitigationStrategy
  actionPlan      String             @db.Text
  picId           String?            @map("pic_id") // Person in charge
  deadline        DateTime?

  // Status
  isCompleted     Boolean            @default(false) @map("is_completed")
  progress        Int                @default(0) // 0-100%
  notes           String?            @db.Text

  createdById     String             @map("created_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  // Relations
  risk            Risk               @relation(fields: [riskId], references: [id], onDelete: Cascade)
  pic             User?              @relation("MitigationPIC", fields: [picId], references: [id])
  createdBy       User               @relation("MitigationCreator", fields: [createdById], references: [id])

  @@index([riskId])
  @@map("risk_mitigations")
// COMPLAINT MODULE (ADUAN & ASPIRASI)
// =====================================

enum ComplaintCategory {
  ACADEMIC
  FACILITY
  SERVICE
  BULLYING
  FINANCE
  OTHER
}

enum ComplaintStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ComplaintPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Complaint - Modul Aduan & Aspirasi (Part of Quality Assurance)
model Complaint {
  id          String   @id @default(uuid())
  unitId      String   @map("unit_id")
  userId      String?  @map("user_id") // Optional for anonymous, but better to track
  category    ComplaintCategory
  subject     String
  description String   @db.Text
  location    String?
  status      ComplaintStatus   @default(PENDING)
  priority    ComplaintPriority @default(NORMAL)
  isAnonymous Boolean  @default(false) @map("is_anonymous")
  attachments Json?    // Array of strings (URLs)

  // Resolution
  assignedToId String?   @map("assigned_to_id")
  resolution   String?   @db.Text
  resolvedAt   DateTime? @map("resolved_at")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  unit       Unit      @relation(fields: [unitId], references: [id])
  user       User?     @relation("ComplaintReporter", fields: [userId], references: [id])
  assignedTo User?     @relation("ComplaintHandler", fields: [assignedToId], references: [id])
  comments   ComplaintComment[]

  @@index([unitId])
  @@index([userId])
  @@index([status])
  @@index([category])
  @@map("complaints")
}

model ComplaintComment {
  id          String   @id @default(uuid())
  complaintId String   @map("complaint_id")
  userId      String   @map("user_id")
  content     String   @db.Text
  isInternal  Boolean  @default(false) @map("is_internal") // Only visible to staff

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([complaintId])
  @@map("complaint_comments")
}
