/// Supplier - Pemasok/Vendor
model Supplier {
  id            String   @id @default(uuid())
  name          String
  address       String?
  phone         String?
  email         String?
  contactPerson String?  @map("contact_person")
  category      String?  // STATIONERY, CATERING, SERVICES, etc.
