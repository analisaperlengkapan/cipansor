# ================================================
# CIPANSOR - Environment Variables Configuration
# Copy this file to .env and fill in the values
# ================================================

# ===================
# Database Configuration
# ===================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cipansor?schema=public"

# Docker DB Configuration (used in docker-compose)
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# ===================
# JWT Authentication
# ===================
# Signing key for every session token. Left EMPTY on purpose — the same
# reason ENCRYPTION_KEY below is empty.
#
# This line used to carry a ready-made value
# ("your-super-secret-key-change-this-in-production-min-32-chars"). Copying
# this file therefore produced a system that started, worked, and signed its
# tokens with a key published in a public repository — so anyone could mint a
# token claiming SUPER_ADMIN and be admitted without a password, with 2FA
# never involved because a forged token never logs in. cipansor.or.id ran that
# way. A placeholder that works is worse than no value at all: nothing fails,
# so nothing gets noticed.
#
# Generate one per environment, and never share it between them:
#   openssl rand -hex 48
#
# The API refuses to start when NODE_ENV=production and this is missing,
# shorter than 32 characters, or still an example value
# (apps/api/src/config/assert-secrets.ts).
JWT_SECRET=
# Access tokens are short-lived; permission and role changes only take effect
# when one is refreshed, so a long TTL means stale privileges persist that long.
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ===================
# Server Configuration
# ===================
PORT=3001
NODE_ENV=development
# Options: development, staging, production

# ===================
# Data Encryption
# ===================
# 32-byte key as 64 hex chars, used to encrypt system secrets at rest
# (apps/api/src/utils/encryption.ts). REQUIRED in production — without it the
# API silently falls back to a public hardcoded default key. Generate with:
#   openssl rand -hex 32
# Rotating this after data is stored makes existing ciphertext undecryptable.
ENCRYPTION_KEY=

# ===================
# Frontend Configuration
# ===================
# API base origin only — the app appends the "/api" prefix itself.
NEXT_PUBLIC_API_URL="http://localhost:3001"
WEB_PORT=3000
# Show the demo-login credential panel on /login ("true" = show). Build-time
# flag (inlined by Next), so the web image must be rebuilt after changing it.
# Enable for demo deployments; leave "false" for a real launch.
NEXT_PUBLIC_SHOW_DEMO_LOGIN=false
# Exempts ONLY the seeded *@demo.cipansor.or.id accounts from the mandatory 2FA
# wall, so the privileged demo roles published on /login are actually openable.
# Runtime flag (API), no rebuild needed. Keep "false" outside a demo deployment.
DEMO_MODE=false

# ===================
# CORS Configuration
# ===================
CORS_ORIGIN="http://localhost:3000"
# For multiple origins (production): "https://cipansor.or.id,https://admin.cipansor.or.id"
# Each entry is matched exactly and the one that matches is reflected back, so
# write the full scheme://host[:port] with no path. "*" is rejected at boot: the
# API sends credentials, and browsers refuse a wildcard on credentialed requests.

# ===================
# Logging Configuration
# ===================
LOG_LEVEL=debug
# Options: error, warn, info, http, verbose, debug

# ===================
# Rate Limiting
# ===================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# More restrictive for auth endpoints
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# ===================
# Redis Configuration (optional)
# ===================
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# ===================
# Production Security
# ===================
# Cookie settings for production
COOKIE_SECURE=false
# Set to true in production with HTTPS
COOKIE_DOMAIN=localhost

# ===================
# File Upload
# ===================
MAX_FILE_SIZE=10485760
# 10MB in bytes
UPLOAD_DIR="./uploads"

# ===================
# Email Configuration (optional)
# ===================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="noreply@cipansor.or.id"

# ===================
# WhatsApp Integration (optional)
# ===================
# WA_API_URL=
# WA_API_KEY=

# ===================
# External Services (optional)
# ===================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# GOOGLE_ANALYTICS_ID=


# WhatsApp Business API — provider META = Cloud API langsung dari Meta
# (tanpa BSP perantara; disarankan). Alternatif: FONNTE/WATROOP/WHACENTER.
# Default SIMULATOR (log-only, tidak mengirim).
WA_PROVIDER="META"
WA_ACCESS_TOKEN=""
WA_PHONE_NUMBER_ID=""

# ===================
# Public AI Assistant (optional)
# ===================
# Chatbot layanan publik di situs. Nonaktif secara bawaan: tanpa provider,
# endpoint menjawab 503 dan widget tidak dirender sama sekali. Itu disengaja —
# asisten setengah jadi yang mengarang biaya dan tanggal pendaftaran lebih
# buruk daripada tidak ada asisten.
#
# Variabel ini harus ikut terdaftar di blok `environment:` service `api` pada
# docker-compose.yml; yang tidak terdaftar di sana tidak akan sampai ke API.
#
# provider: openai-compatible | stub | disabled
CHATBOT_PROVIDER="disabled"
CHATBOT_API_BASE_URL=""
CHATBOT_API_KEY=""
CHATBOT_MODEL=""
# Gaya bahasa tingkat deployment. Persona yang disimpan Super Admin lewat
# /settings/chatbot mengalahkan nilai ini.
CHATBOT_PERSONA=""
# LLM di halaman publik adalah sasaran amplifikasi biaya — batasi lajunya.
CHATBOT_RATE_LIMIT_WINDOW_MS=60000
CHATBOT_RATE_LIMIT_MAX_REQUESTS=10
