# ================================================
# CIPANSOR - Environment Variables Configuration
# Copy this file to .env and fill in the values
# ================================================

# ===================
# Database Configuration
# ===================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cipansor?schema=public"

# Docker DB Configuration (used in docker-compose)
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# ===================
# JWT Authentication
# ===================
# IMPORTANT: Change these in production!
JWT_SECRET="your-super-secret-key-change-this-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# ===================
# Server Configuration
# ===================
PORT=3001
NODE_ENV=development
# Options: development, staging, production

# ===================
# Frontend Configuration
# ===================
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
WEB_PORT=3000

# ===================
# CORS Configuration
# ===================
CORS_ORIGIN="http://localhost:3000"
# For multiple origins (production): "https://cipansor.id,https://admin.cipansor.id"

# ===================
# Logging Configuration
# ===================
LOG_LEVEL=debug
# Options: error, warn, info, http, verbose, debug

# ===================
# Rate Limiting
# ===================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
# More restrictive for auth endpoints
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# ===================
# Redis Configuration (optional)
# ===================
REDIS_URL="redis://localhost:6379"
REDIS_PORT=6379

# ===================
# Production Security
# ===================
# Cookie settings for production
COOKIE_SECURE=false
# Set to true in production with HTTPS
COOKIE_DOMAIN=localhost

# ===================
# File Upload
# ===================
MAX_FILE_SIZE=10485760
# 10MB in bytes
UPLOAD_DIR="./uploads"

# ===================
# Email Configuration (optional)
# ===================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="noreply@cipansor.id"

# ===================
# WhatsApp Integration (optional)
# ===================
# WA_API_URL=
# WA_API_KEY=

# ===================
# External Services (optional)
# ===================
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# GOOGLE_ANALYTICS_ID=

