enum PurchaseRequestStatus {
  PENDING   // Menunggu persetujuan
  APPROVED  // Disetujui Kepala/Yayasan
  REJECTED  // Ditolak
  ORDERED   // Sudah dipesan
  RECEIVED  // Barang diterima (Masuk Inventaris)
  CANCELLED // Dibatalkan
}

/// PurchaseRequest - Pengajuan Pengadaan Barang
model PurchaseRequest {
  id              String                @id @default(uuid())
  unitId          String                @map("unit_id")
  code                String                @unique // PR-YYYYMM-XXXX
  requesterId         String                @map("requester_id")
  preferredSupplierId String?               @map("preferred_supplier_id")
  date                DateTime              @default(now())
  description         String?               @db.Text
  totalEstimated  Decimal               @map("total_estimated") @db.Decimal(15, 2)
  status          PurchaseRequestStatus @default(PENDING)

  // Approval
  approvedById    String?               @map("approved_by_id")
  approvedAt      DateTime?             @map("approved_at")
  rejectionReason String?               @map("rejection_reason")

  // Fulfillment
  orderedAt       DateTime?             @map("ordered_at")
  receivedAt      DateTime?             @map("received_at")

  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  // Relations
  unit              Unit                  @relation(fields: [unitId], references: [id])
  requester         User                  @relation("PRRequester", fields: [requesterId], references: [id])
  preferredSupplier Supplier?             @relation(fields: [preferredSupplierId], references: [id])
  approvedBy        User?                 @relation("PRApprover", fields: [approvedById], references: [id])
  items             PurchaseRequestItem[]

  @@index([unitId])
  @@index([status])
  @@index([date])
  @@map("purchase_requests")
}

/// PurchaseRequestItem - Item Pengajuan
model PurchaseRequestItem {
  id              String   @id @default(uuid())
  requestId       String   @map("request_id")
  itemName        String   @map("item_name")
  quantity        Int
  unit            String   @default("pcs")
  estimatedPrice  Decimal  @map("estimated_price") @db.Decimal(15, 2)
  totalPrice      Decimal  @map("total_price") @db.Decimal(15, 2)

  // Link to Asset Category for auto-creation later
  assetCategoryId String?  @map("asset_category_id")

  // Optional Budget Link (to check availability)
  budgetId        String?  @map("budget_id")

  // Relations
  request       PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  assetCategory AssetCategory?  @relation(fields: [assetCategoryId], references: [id])
  budget        Budget?         @relation(fields: [budgetId], references: [id])

  @@index([requestId])
  @@map("purchase_request_items")
}

