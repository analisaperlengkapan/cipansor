generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ResearchProject {
  id String @id @default(uuid())
  unitId String
  title String
  abstract String?
  category String
  leaderId String
  leader User @relation(fields: [leaderId], references: [id])
  status String @default("PROPOSAL")
  findings String?
  budget Decimal?
  milestones ResearchMilestone[]
  updatedAt DateTime @updatedAt
}

model ResearchMilestone {
  id String @id @default(uuid())
  projectId String
  project ResearchProject @relation(fields: [projectId], references: [id])
  title String
  status String @default("PENDING")
  sortOrder Int @default(0)
}

model InnovationProposal {
  id String @id @default(uuid())
  unitId String
  title String
  description String?
  category String
  proposerId String
  proposer User @relation(fields: [proposerId], references: [id])
  status String @default("IDEA")
  score Int?
  approvedById String?
  approvedBy User? @relation("ApprovedInnovations", fields: [approvedById], references: [id])
}

model StandardOperatingProcedure {
  id String @id @default(uuid())
  unitId String
  title String
  content String?
  status String @default("DRAFT")
  updatedAt DateTime @updatedAt
  category String
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
}

model User {
  id String @id @default(uuid())
  name String
  researchProjects ResearchProject[]
  innovationProposals InnovationProposal[]
  approvedInnovations InnovationProposal[] @relation("ApprovedInnovations")
  sops StandardOperatingProcedure[]
}

model PlanActivity {
  id String @id @default(uuid())
  objectiveId String
  title String
  description String?
}

model StrategicPlan {
  id String @id @default(uuid())
  unitId String
  status String
  progress Float @default(0)
}

model JournalEntry {
  id String @id @default(uuid())
  unitId String
  accountId String
  date DateTime
  debit Decimal
  credit Decimal
}

model ShariaCompliance {
  id String @id @default(uuid())
  unitId String
  score Int?
  status String
  category String
}

model AuditFinding {
  id String @id @default(uuid())
  status String @default("OPEN")
}

model Risk {
  id String @id @default(uuid())
  unitId String
  riskLevel String
  status String @default("OPEN")
}
